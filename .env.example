# ==============================================================================
# HSKChain Configuration (Official Developer QuickStart: https://docs.hskchain.net)
# ==============================================================================

# Network Selection:
# Testnet: 133 (default) | Mainnet: 177
NEXT_PUBLIC_CHAIN_ID=133
NEXT_PUBLIC_RPC_URL=https://testnet.hsk.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet-explorer.hsk.xyz

# Mainnet Alternative:
# NEXT_PUBLIC_CHAIN_ID=177
# NEXT_PUBLIC_RPC_URL=https://mainnet.hsk.xyz
# NEXT_PUBLIC_EXPLORER_URL=https://hashkey.blockscout.com

# ==============================================================================
# Deployed Smart Contract Addresses
# (Deploy locally/testnet with: forge script script/Deploy.s.sol:Deploy --rpc-url https://testnet.hsk.xyz --broadcast)
# ==============================================================================
NEXT_PUBLIC_HASHGUARD_ADDRESS=
NEXT_PUBLIC_USERNAME_REGISTRY_ADDRESS=

# Optional Global Stablecoins & ERC-20 Tokens (Mainnet has native USDT/USDC/DAI/EURC/WETH built-in)
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_DAI_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=
NEXT_PUBLIC_WETH_ADDRESS=

# ==============================================================================
# Supabase Configuration (Optional - For off-chain username indexing & profiles)
# If not configured, HashGuard automatically uses on-chain UsernameRegistry or local fallback!
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==============================================================================
# AI Agent Multi-LLM Configuration (Server-side only)
# Priority order: GEMINI_API_KEY -> MISTRAL_API_KEY -> OPENAI_API_KEY -> Local Regex Parser
# ==============================================================================
# Google Gemini (Recommended for speed & structured outputs - https://aistudio.google.com)
GEMINI_API_KEY=

# Mistral AI (https://console.mistral.ai)
MISTRAL_API_KEY=

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

